---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        simplestcode
      </h1>

      <p class="text-foreground/70 text-lg">
        I build simple, focused mobile apps for iOS and Android. No ads, no
        accounts, no tracking. Just tools and games that do what they say.
      </p>

      <p class="text-foreground/70 mt-2 text-lg">
        Your privacy is not a feature — it is the default. My apps collect
        nothing, store nothing, and share nothing. No analytics SDKs, no
        crash reporters, no third-party code watching you.
      </p>

      <p class="text-foreground/70 mt-2 text-lg">
        Every purchase is a one-time transaction. No subscriptions, no
        recurring fees, no drip pricing. You pay once and you own it. I
        never see your payment details — that stays between you and your
        app store.
      </p>

      <p class="text-foreground/70 mt-2 text-lg">
        I believe sustainability is the future. A business does not need to
        grow forever. It should aim to be a healthy part of people's lives,
        not their jail — earning enough to keep going, not extracting every
        last minute and dollar.
      </p>

      <p class="text-foreground/70 mt-2 text-lg">
        This is not a company. It is a workshop. One person, honest work,
        clear terms, no fine print. If that speaks to you, you know where
        to find me.
      </p>
      

      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>